{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {},
    "app/*": {
      "entry": ["src/main.ts", "src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "feature/*/**": {
      "project": ["**/*.ts"]
    },
    "infrastructure/*/**": {
      "project": ["src/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": []
}
