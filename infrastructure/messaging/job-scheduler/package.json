    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "require": "./dist/contracts.js"
    }
  },
  "dependencies": {
    "@feature/shared": "workspace:*",
    "@infra/messaging-queue": "workspace:*",
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "bullmq": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  }
}
