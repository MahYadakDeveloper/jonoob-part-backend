{
  "name": "@infra/messaging-job-scheduler",
  "private": true,
  "scripts": {
    "dev": "pnpm exec tsc -w",
    "build": "pnpm exec tsc"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
