model Province {
  id             Int    @id
  name           String
  normalizedName String

  cities City[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([normalizedName])
}

model City {
  id             Int    @id
  name           String
  normalizedName String

  provinceId Int
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provinceId])
  @@index([name])
  @@index([normalizedName])
  @@index([provinceId])
}
