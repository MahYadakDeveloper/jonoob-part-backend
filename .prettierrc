{
  "semi": true,
  "singleQuote": true,
  "printWidth": 80,
  "tabWidth": 2,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-jsdoc"],
  "jsdocPrintWidth": 80,
  "jsdocSeparateReturnsFromParam": true,
  "jsdocCapitalizeDescription": false
}
