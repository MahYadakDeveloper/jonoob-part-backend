{
  "extends": ["./base.json"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "**",
              "!./**",
              "!../**",
              "!@nestjs/common",
              "!@feature/shared",
              "!@feature/shared/**",
              "!@feature/error-http",
              "!@feature/error-http/**"
            ],
            "message": "errors packages may only depend on @feature/shared."
          }
        ]
      }
    ]
  }
}
