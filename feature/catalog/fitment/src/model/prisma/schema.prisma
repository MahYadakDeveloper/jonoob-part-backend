model VehicleNode {
  id String @id @default(cuid())

  type VehicleNodeType
  name String

  parentId String?
  parent VehicleNode? @relation(
    "VehicleNodeParent",
    fields: [parentId],
    references: [id]
  )

  @@unique([parentId, type, name])
}

model Fitment {
  id String @id @default(cuid())

  referenceId String
  reference VehicleNode @relation(
    fields: [referenceId],
    references: [id]
  )

  madeModel DateTime?
}

enum VehicleNodeType {
  make
  model
  series
  transmission
  fuelType
}