{
  "name": "@feature/order",
  "type": "commonjs",
  "scripts": {
    "dev": "pnpm exec tsc -w",
    "build": "pnpm exec tsc",
    "cli": "ts-node -r tsconfig-paths/register src/cli/main.ts",
    "seed:locations": "pnpm cli seed locations --file data/locations.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules pnpm exec jest --watch --verbose"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "private": true,
  "dependencies": {
    "@casl/ability": "catalog:",
    "@feature/actors-api": "workspace:*",
    "@feature/cashback-api": "workspace:*",
    "@feature/catalog-api": "workspace:*",
    "@feature/media-api": "workspace:*",
    "@feature/order-api": "workspace:*",
    "@feature/pricing-api": "workspace:*",
    "@feature/schedule-api": "workspace:*",
    "@feature/shared": "workspace:*",
    "@feature/warehouse-api": "workspace:*",
    "@infra/db-drizzle": "workspace:*",
    "@infra/messaging-job-scheduler": "workspace:*",
    "@infra/messaging-queue": "workspace:*",
    "@infra/payment-gateway": "workspace:*",
    "@infra/settings-store": "workspace:*",
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/drizzle": "catalog:",
    "@nestjs/outbox": "catalog:",
    "bullmq": "catalog:",
    "drizzle-orm": "catalog:",
    "nest-commander": "catalog:",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "ts-node": "^10.9.2"
  }
}
