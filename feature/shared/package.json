{
  "name": "@feature/shared",
  "type": "commonjs",
  "scripts": {
    "dev": "pnpm exec tsc -w",
    "build": "pnpm exec tsc"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "import": "./dist/types/*.js",
      "require": "./dist/types/*.js"
    },
    "./decorators/*": {
      "types": "./dist/decorators/*.d.ts",
      "import": "./dist/decorators/*.js",
      "require": "./dist/decorators/*.js"
    },
    "./guards/*": {
      "types": "./dist/guards/*.d.ts",
      "import": "./dist/guards/*.js",
      "require": "./dist/guards/*.js"
    },
    "./contracts/*": {
      "types": "./dist/contracts/*.d.ts",
      "import": "./dist/contracts/*.js",
      "require": "./dist/contracts/*.js"
    }
  },
  "private": true,
  "peerDependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "rxjs": "catalog:"
  },
  "dependencies": {
    "@casl/ability": "catalog:",
    "fastify": "catalog:",
    "zod": "catalog:"
  }
}
