{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "import"],
  "jsPlugins": [
    "eslint-plugin-boundaries",
    "./packages/oxlint-plugins/drizzle.mjs",
    "./packages/oxlint-plugins/nest.mjs"
  ],
  "settings": {
    "boundaries/include": ["src/**/*.ts"],
    "boundaries/elements": [
      { "type": "helper", "pattern": "src/helpers/*" },
      { "type": "component", "pattern": "src/components/*" },
      { "type": "module", "pattern": "src/modules/*" }
    ],
    "import/resolver": {
      "oxc": {
        "tsconfig": { "configFile": "./tsconfig.json", "references": "auto" }
      }
    }
  },
  "rules": {
    "boundaries/no-unknown-dependencies": "error",
    "boundaries/dependencies": [
      "error",
      {
        "default": "disallow",
        "policies": [
          {
            "from": { "element": { "type": "component" } },
            "allow": { "to": { "element": { "type": "helper" } } }
          },
          {
            "from": { "element": { "type": "module" } },
            "allow": {
              "to": { "element": { "type": ["component", "helper"] } }
            }
          }
        ]
      }
    ],

    // oxlint base rules.
    "typescript/no-explicit-any": "off",
    "typescript/no-floating-promises": "error",
    "no-unused-vars": ["error", { "fix": { "imports": "safe-fix" } }]
  },
  "categories": { "correctness": "error" },
  "env": { "node": true, "es2022": true },
  "ignorePatterns": ["**/dist", "**/node_modules", "**/coverage"],
  "options": { "typeAware": true, "reportUnusedDisableDirectives": "warn" }
}
